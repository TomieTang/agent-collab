{
  "name": "agent-collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "多模型 Agent 协作平台：基于 opencode server，让不同模型互相设计、评审、核验",
  "scripts": {
    "start": "node server.mjs",
    "mock": "COLLAB_MOCK=1 COLLAB_PASSWORD=collab node server.mjs",
    "test": "node test/e2e.mjs",
    "connector": "node src/connector.mjs",
    "connector:dry": "node src/connector.mjs --dry --once"
  },
  "engines": {
    "node": ">=20"
  }
}
